function getContentType(filename) {
  if (filename.endsWith('.js')) return 'application/javascript';
  if (filename.endsWith('.ts')) return 'application/typescript';
  if (filename.endsWith('.css')) return 'text/css';
  if (filename.endsWith('.html')) return 'text/html; charset=utf-8';
  if (filename.endsWith('.json')) return 'application/json';
  if (filename.endsWith('.svg')) return 'image/svg+xml';
  if (filename.endsWith('.png')) return 'image/png';
  if (filename.endsWith('.jpeg') || filename.endsWith('.jpg')) return 'image/jpeg';
  if (filename.endsWith('.gif')) return 'image/gif';
  return 'application/octet-stream';
}
function proxyRequestToServer(req, res) {
  const targetPort = serverPort || 8000;
  const targetHost = LOCAL_CLIENT_HOST;
  const url = new URL(req.url, `http://${req.headers.host}`);
  const options = {
    hostname: targetHost,
    port: targetPort,
    path: url.pathname + url.search,
    method: req.method,
    headers: Object.assign({}, req.headers, { host: `${targetHost}:${targetPort}` }),
  };
  const proxyReq = http.request(options, proxyRes => {
    res.writeHead(proxyRes.statusCode || 500, proxyRes.headers);
    proxyRes.pipe(res, { end: true });
  });
  proxyReq.on('error', err => {
    console.error('[is] proxy error:', err.message);
    res.writeHead(502);
    res.end('Bad Gateway');
  });
  req.pipe(proxyReq, { end: true });
}
function startStaticClientServer() {
  const server = http.createServer((req, res) => {
    const url = new URL(req.url, `http://${req.headers.host}`);
    let pathname = decodeURIComponent(url.pathname);
    if (pathname === '/') {
      const target = `http://${LOCAL_CLIENT_HOST}:${clientPort}/testclient.html?~~${LOCAL_CLIENT_HOST}:${serverPort || 8000}&login=${LOCAL_CLIENT_HOST}:8080`;
      res.writeHead(302, { Location: target });
      res.end();
      return;
    }
    if (pathname.startsWith('/~~')) {
      console.log('[is] proxying same-origin request to server:', pathname + url.search);
      proxyRequestToServer(req, res);
      return;
    }
    if (pathname === '/setup-testclient-key') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(`<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Setup Testclient Key</title></head><body>
<h1>Setup testclient key</h1>
<p>Paste the contents of your PS <code>sid</code> cookie here.</p>
<form method="POST" action="/save-testclient-key">
<textarea name="sid" rows="4" cols="60"></textarea><br>
<button type="submit">Save</button>
</form>
<p>Then refresh <a href="/testclient.html">testclient.html</a>.</p>
</body></html>`);
      return;
    }
    if (pathname === '/save-testclient-key') {
      let body = '';
      req.on('data', chunk => { body += chunk; });
      req.on('end', () => {
        const params = new URLSearchParams(body);
        const sid = params.get('sid') || '';
        const configDir = path.join(CLIENT_DIR, 'config');
        fs.mkdirSync(configDir, { recursive: true });
        const configPath = path.join(configDir, 'testclient-key.js');
        fs.writeFileSync(configPath, `const POKEMON_SHOWDOWN_TESTCLIENT_KEY = '${sid.replace(/'/g, "\\'")}';`);
        res.writeHead(302, { Location: '/testclient.html' });
        res.end();
      });
      return;
    }
    if (pathname.endsWith('/')) pathname += 'testclient.html';
    const relativePath = pathname.replace(/^[/\\]+/, '');
    const filePath = path.join(CLIENT_DIR, relativePath);
    const normalizedClientDir = path.normalize(CLIENT_DIR + path.sep);
    if (!filePath.startsWith(normalizedClientDir)) {
      console.error('[is] static request forbidden:', pathname, '->', filePath);
      res.writeHead(403);
      res.end('Forbidden');
      return;
    }
    if (relativePath === 'config/testclient-key.js' || relativePath === `config${path.sep}testclient-key.js`) {
      if (!fs.existsSync(filePath)) {
        res.writeHead(200, { 'Content-Type': 'application/javascript' });
        res.end('const POKEMON_SHOWDOWN_TESTCLIENT_KEY = undefined; console.warn("testclient key not found. Visit /setup-testclient-key to save one.");');
        return;
      }
    }
    console.log('[is] static request:', pathname, '->', filePath);
    fs.stat(filePath, (err, stats) => {
      if (err || !stats.isFile()) {
        console.error('[is] static file not found:', pathname, '->', filePath, err?.code || '');
        res.writeHead(404);
        res.end('Not found');
        return;
      }
      res.writeHead(200, { 'Content-Type': getContentType(filePath) });
      fs.createReadStream(filePath).pipe(res);
    });
  });
  server.on('error', err => {
    console.error('[is] static client server error:', err.message);
    process.exit(1);
  });
  server.listen(clientPort, LOCAL_CLIENT_HOST, () => {
    console.log(`[is] static test client available at http://${LOCAL_CLIENT_HOST}:${clientPort}/testclient.html?~~${LOCAL_CLIENT_HOST}:${serverPort || 8000}`);
  });
  return server;
}
